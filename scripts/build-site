#!/bin/sh
set -eu

HUGO_VERSION=0.164.0
HUGO_DIGEST=sha256:f8671f2299e60154536c158bff8ce27f6eef4dddbbfc73bcce66263276ae0f80
IMAGE="ghcr.io/gohugoio/hugo:v${HUGO_VERSION}@${HUGO_DIGEST}"
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

docker run --rm \
  --user "$(id -u):$(id -g)" \
  --volume "$ROOT:/project" \
  --workdir /project \
  --env HUGO_CACHEDIR=/tmp/hugo-cache \
  --entrypoint /bin/sh \
  "$IMAGE" \
  -c 'find /project/static -mindepth 1 -delete && hugo --destination /project/static --gc --minify --noBuildLock'
