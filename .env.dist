# Compose project name. Change this when running multiple deployments on one host.
COMPOSE_PROJECT_NAME=tooltown

# Host port exposed by the local Docker Compose stack.
TOOLTOWN_PORT=8080

# OpenTelemetry export to the self-hosted collector on Severed, which fans
# traces to Tempo, metrics to Prometheus, and logs to Loki. The route is
# Tailscale-only and needs no authorization header. Leave the endpoint empty to
# disable telemetry.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://otelcol.void.cold.at
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_SERVICE_NAME=tooltown
OTEL_RESOURCE_ATTRIBUTES=

# Sentry errors, logs, and metrics. Keep the project DSN in local/deployment
# secrets rather than committing it here.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Production deployment settings used by compose.deploy.yaml.
TOOLTOWN_IMAGE=ghcr.io/rwese/tooltown:latest
TOOLTOWN_RESTART_POLICY=unless-stopped
TOOLTOWN_CONTAINER_PORT=8080
TOOLTOWN_HOST=tooltown.void.cold.at
TOOLTOWN_TRAEFIK_ENABLED=true
TOOLTOWN_TRAEFIK_ROUTER=tooltown
TOOLTOWN_TRAEFIK_SERVICE=tooltown
TOOLTOWN_TRAEFIK_ENTRYPOINTS=websecure
TOOLTOWN_TRAEFIK_TLS=true
TOOLTOWN_MANAGED_BY=apps
TOOLTOWN_WATCHTOWER_ENABLED=true
