# Compose project name. Change this when running multiple deployments on one host.
COMPOSE_PROJECT_NAME=tooltown

# Host port exposed by the local Docker Compose stack.
TOOLTOWN_PORT=8080

# Production deployment settings used by compose.deploy.yaml.
TOOLTOWN_IMAGE=ghcr.io/rwese/tooltown:latest
TOOLTOWN_RESTART_POLICY=unless-stopped
TOOLTOWN_CONTAINER_PORT=8080
TOOLTOWN_HOST=tooltown.void.cold.at
TOOLTOWN_TRAEFIK_ENABLED=true
TOOLTOWN_TRAEFIK_ROUTER=tooltown
TOOLTOWN_TRAEFIK_SERVICE=tooltown
TOOLTOWN_TRAEFIK_ENTRYPOINTS=websecure
TOOLTOWN_TRAEFIK_TLS=true
TOOLTOWN_MANAGED_BY=apps
TOOLTOWN_WATCHTOWER_ENABLED=true
