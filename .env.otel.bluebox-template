# OTel configuration template — managed by Bluebox
#
# IMPORTANT: Before editing this file, load the bluebox-otel-instrumentation skill
# in your coding agent. The skill completes all language-specific SDK wiring.
#
# Token security: your ingest token belongs in your secret manager or CI secrets,
# NEVER in this file, NEVER committed to version control.
# When you need to set the Authorization header in your SDK or collector, copy the
# exact OTEL_EXPORTER_OTLP_HEADERS value shown by Bluebox for this workspace.
# Example:
#   OTEL_EXPORTER_OTLP_HEADERS="<header value from Bluebox>"
# Replace the placeholder with the real value from your Bluebox workspace.

# Fixed: use http/protobuf — do NOT switch to gRPC/port 4317.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# OTLP ingest endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=https://tem70528.live.dynatrace.com/api/v2/otlp

# Stable service identity.
OTEL_SERVICE_NAME=tooltown

# Deployment configuration may override the environment value.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=rwese,deployment.environment=production

# Bluebox accepts delta metrics; cumulative metrics are rejected.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
